{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiitco",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
  },
  "services": [
    { "binding": "WORKOUT_BUILDER", "service": "hiit-co-workout-builder" },
  ],
  "ratelimits": [
    {
      "name": "CONTROL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL_STORE", "class_name": "ControlStore" },
      { "name": "MEMBER_TRAINING_LOGS", "class_name": "MemberTrainingStore" },
      {
        "name": "GYMMASTER_CHECKIN_INBOX",
        "class_name": "GymMasterCheckinInbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "gymmaster-checkin-inbox-v1",
      "new_sqlite_classes": ["GymMasterCheckinInbox"],
    },
    {
      "tag": "member-training-v1",
      "new_sqlite_classes": ["MemberTrainingStore"],
    },
    { "tag": "control-room-v1", "new_sqlite_classes": ["ControlStore"] },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
}
